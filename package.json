{
  "name": "study-in-germany",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:data": "node scripts/check-content-data.mjs",
    "check:scope": "node scripts/check-monitoring-scope.mjs",
    "check:content": "node scripts/check-content-freshness.mjs",
    "check:style": "node scripts/check-content-style.mjs",
    "check:knowledge": "node scripts/check-dev-knowledge.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "check:audit": "node scripts/audit-production.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:data && npm run check:scope && npm run check:style && npm run check:audit && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "supabase": "^2.110.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": ">=8.5.23"
  }
}
